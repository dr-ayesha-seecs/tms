# Copy to .env for local development. Never commit real values.
# On Netlify: Site configuration → Environment variables.
# Same names the app reads. Production data is the Firestore copy of the SQLite file.

# Required in production.
# HMAC key for the login cookie (tms_session) and the visit cookie (tms_seen).
# Long random string. If this is empty, the app uses a public dev fallback.
SESSION_SECRET=

# Optional alias, used only when SESSION_SECRET is empty.
# TMS_SESSION_SECRET=

# --- Database ---
# When any Firebase credential below is set, the app stores the whole SQLite
# database in Firestore (collection tms_db by default) and does not write a
# database file on the server. Netlify functions cannot keep that file on disk.

# Preferred. Base64 of the entire Firebase service-account JSON
# (Firebase console → Project settings → Service accounts → Generate new private key).
#   base64 -w0 service-account.json
# Secret.
FIREBASE_SERVICE_ACCOUNT_BASE64=

# Alternative to FIREBASE_SERVICE_ACCOUNT_BASE64. All three are required together.
# FIREBASE_PRIVATE_KEY is secret and may contain literal \n sequences.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Optional. Firestore collection that holds the SQLite snapshot.
# Must look like tms_<letters_digits_underscores>. Default is tms_db.
# Use the same name as the existing database so the live data is reused.
# TMS_FIRESTORE_COLLECTION=tms_db

# Optional alternative database. Ignored when Firebase credentials are set.
# Both are secret. Not required for the Netlify + Firestore setup.
# TURSO_DATABASE_URL=
# TURSO_AUTH_TOKEN=

# Set by the platform. Do not add NODE_ENV yourself in the Netlify UI.
# NODE_VERSION is set to 24 in netlify.toml.
