# Copy to .env for local development. Never commit real values.
# On Netlify: Site configuration → Environment variables.
# Production (tms-mnsuam.netlify.app) uses Turso.

# Required in production.
# HMAC key for the login cookie (tms_session) and the visit cookie (tms_seen).
# Long random string. If this is empty, the app uses a public dev fallback.
SESSION_SECRET=

# Optional alias, used only when SESSION_SECRET is empty.
# TMS_SESSION_SECRET=

# --- Database (production: Turso) ---
# Both are required together. Secret.
# TURSO_DATABASE_URL is a libsql:// or file: URL. TURSO_AUTH_TOKEN is the database token.
# When these are set, and no Firebase credential is set, the app uses Turso.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- Optional: Firebase Firestore snapshot ---
# If any Firebase credential below is set, the app stores one SQLite file in
# Firestore and ignores Turso. Leave these unset on the Netlify site.

# Base64 of the entire Firebase service-account JSON. Secret.
# FIREBASE_SERVICE_ACCOUNT_BASE64=

# Alternative to FIREBASE_SERVICE_ACCOUNT_BASE64. All three are required together.
# FIREBASE_PRIVATE_KEY is secret and may contain literal \n sequences.
# FIREBASE_PROJECT_ID=
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=

# Firestore collection for the SQLite snapshot. Default tms_db.
# Must look like tms_<letters_digits_underscores>.
# TMS_FIRESTORE_COLLECTION=tms_db

# Set by the platform. Do not add NODE_ENV yourself in the Netlify UI.
# NODE_VERSION is set to 24 in netlify.toml.
